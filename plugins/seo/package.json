{
  "name": "@tutitoos/seo-codex-plugin",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "dashboard": "astro dev --host 127.0.0.1 --port 4321 --open",
    "build": "astro check && astro build",
    "start": "HOST=127.0.0.1 PORT=4321 node dist/server/entry.mjs",
    "check": "astro check && node scripts/check-syntax.mjs && node scripts/validate-links.mjs",
    "smoke:tools": "node scripts/smoke-tools.mjs",
    "crawl:audit": "node scripts/crawl-site-audit.mjs",
    "attach:evidence": "node scripts/attach-page-evidence.mjs",
    "audit:deep": "node scripts/run-deep-audit.mjs",
    "audit:render": "node scripts/render-page-evidence.mjs",
    "audit:lighthouse": "node scripts/run-lighthouse-page.mjs",
    "test": "node --test test/*.test.mjs integrations/*/test/*.test.mjs",
    "validate": "npm run check && npm test && npm run smoke:tools && npm run build"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.10",
    "echarts": "^6.0.0",
    "marked": "18.0.11",
    "playwright-core": "1.55.0",
    "lighthouse": "13.0.1",
    "chrome-launcher": "1.1.2",
    "sanitize-html": "2.17.7",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^22.15.3",
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^5.9.3"
  }
}
