{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tutitoos/seo-plugin/schemas/audit-findings.schema.json",
  "title": "SEO audit findings v1-v4",
  "type": "object",
  "required": ["version", "counts", "findings"],
  "properties": {
    "version": { "enum": [1, 2, 3, 4] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "counts": { "type": "object" },
    "findings": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "finding": { "type": "object", "required": ["id", "fingerprint", "ruleId", "scope", "severity", "category", "title", "explanation", "evidence", "impact", "source", "confidence", "actions"], "properties": { "id": { "type": "string" }, "fingerprint": { "type": "string" }, "ruleId": { "type": "string" }, "scope": { "enum": ["global", "page", "resource"] }, "severity": { "enum": ["p0", "p1", "p2", "p3", "info"] }, "category": { "type": "string" }, "title": { "type": "string" }, "explanation": { "type": "string" }, "evidence": { "type": "string" }, "impact": { "type": "string" }, "affectedUrls": { "type": "array", "maxItems": 500, "items": { "type": "string", "format": "uri" } }, "resources": { "type": "array", "maxItems": 100 }, "source": { "type": "string" }, "confidence": { "enum": ["high", "medium", "low"] }, "actions": { "type": "array", "maxItems": 8 }, "observedAt": { "type": "string", "format": "date-time" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
