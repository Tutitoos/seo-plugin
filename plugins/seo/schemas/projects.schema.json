{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tutitoos/seo-plugin/schemas/projects.schema.json",
  "title": "SEO project settings v1",
  "type": "object",
  "required": ["version", "projects"],
  "properties": {
    "version": { "const": 1 },
    "projects": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/project" } }
  },
  "$defs": {
    "project": {
      "type": "object",
      "required": ["id", "timezone", "currency", "targets"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "timezone": { "type": "string" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "canonicalUrl": { "type": ["string", "null"], "format": "uri" },
        "localeMap": { "type": "object", "additionalProperties": { "type": "string" } },
        "crawlExclusions": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
        "allowPrivateHosts": { "type": "boolean" },
        "lighthouseBudget": { "type": "object", "properties": { "maxPages": { "type": "integer", "minimum": 0, "maximum": 10 }, "maxRepeats": { "type": "integer", "minimum": 1, "maximum": 3 } }, "additionalProperties": false },
        "targets": { "type": "object", "additionalProperties": { "type": ["object", "null"] } },
        "createdAt": { "type": ["string", "null"], "format": "date-time" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
