{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tutitoos/seo-plugin/schemas/business-profile-capture.schema.json",
  "title": "Temporary Google Business Profile capture v1",
  "type": "object",
  "required": ["version", "reference", "location", "attributes", "reviewSummary", "media", "reviews", "posts", "performance", "diagnostics"],
  "properties": {
    "version": { "const": 1 },
    "reference": {
      "type": "object",
      "required": ["captureId", "profileId", "accountName", "locationName", "capturedAt", "expiresAt", "status", "coverage", "diagnosticsCount", "truncated"],
      "properties": {
        "captureId": { "type": "string" },
        "profileId": { "type": "string" },
        "accountName": { "type": "string", "pattern": "^accounts/[0-9]+$" },
        "locationName": { "type": "string", "pattern": "^locations/[0-9]+$" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["available", "partial", "unavailable"] },
        "coverage": { "type": "object" },
        "diagnosticsCount": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "object" }
      },
      "additionalProperties": false
    },
    "location": { "type": "object" },
    "attributes": { "type": ["array", "object"] },
    "reviewSummary": { "type": "object" },
    "media": { "type": "array", "maxItems": 40 },
    "reviews": { "type": "array", "maxItems": 20 },
    "posts": { "type": "array", "maxItems": 20 },
    "performance": { "type": "object" },
    "diagnostics": { "type": "array", "maxItems": 90 }
  },
  "additionalProperties": false
}
