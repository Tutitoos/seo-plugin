{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tutitoos/seo-plugin/schemas/audit-manifest.schema.json",
  "title": "SEO Plugin audit manifest",
  "type": "object",
  "required": ["version", "id", "title", "project", "auditType", "status", "createdAt", "updatedAt"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "project": {
      "type": "object",
      "required": ["slug", "name"],
      "properties": { "slug": { "type": "string" }, "name": { "type": "string" } },
      "additionalProperties": false
    },
    "profileId": { "type": ["string", "null"] },
    "auditType": { "type": "string" },
    "status": { "enum": ["draft", "completed", "failed"] },
    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "summary": { "type": "string" },
    "skillsUsed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "artifacts": { "type": "array" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
