---
// @ts-nocheck
const { inventory = {}, diagnostics = [] } = Astro.props;
const sitemaps = inventory.sitemaps || [];
const manifests = inventory.manifests || (inventory.manifest ? [inventory.manifest] : []);
const agentFiles = inventory.aiFiles || inventory.agentFiles || [];
const schemas = inventory.schemas?.types || inventory.schema || [];
const resourceGroups = [["Manifests", manifests], ["Feeds", inventory.feeds || []], ["Archivos para agentes", agentFiles], ["Recursos críticos", inventory.criticalResources || []]];
---
{diagnostics.length > 0 && <section class="diagnostic-list"><div class="section-head compact"><div><p class="eyebrow">Feedback de recopilación</p><h2>Incidencias de datos</h2></div><span class="muted">{diagnostics.length} avisos</span></div>{diagnostics.map((item) => <article class={`diagnostic ${item.retryable ? "diagnostic-retry" : ""}`}><header><code>{item.code}</code><span>{item.source}</span><time>{item.attemptedAt?.slice(0, 16).replace("T", " ")}</time></header><h3>{item.message}</h3><p><strong>Efecto:</strong> {item.completenessImpact}</p><p><strong>Siguiente acción:</strong> {item.nextAction}</p><small>{item.retryable ? "Se puede reintentar" : "Requiere intervención o no es recuperable automáticamente"}</small></article>)}</section>}

<div class="inventory-grid">
  <section class="inventory-card inventory-wide"><header><div><span class="pill">Descubrimiento</span><h3>Sitemaps</h3></div><strong>{sitemaps.length}</strong></header>{sitemaps.length ? <div class="sitemap-tree">{sitemaps.map((sitemap) => <details open><summary><span>{sitemap.type === "index" ? "Índice" : "Sitemap"}</span><code>{sitemap.url}</code><strong>{sitemap.urlCount ?? (Array.isArray(sitemap.urls) ? sitemap.urls.length : sitemap.urls) ?? 0} URLs</strong></summary><div class="resource-meta"><span>HTTP {sitemap.status ?? "—"}</span><span>{sitemap.errors?.length || 0} errores</span><span>{sitemap.warnings?.length || 0} avisos</span></div>{Array.isArray(sitemap.children) && sitemap.children.length > 0 && <ul>{sitemap.children.map((child) => <li><code>{child}</code></li>)}</ul>}{Array.isArray(sitemap.urls) && sitemap.urls.length > 0 && <div class="sitemap-url-list">{sitemap.urls.slice(0, 50).map((item) => <div><code>{item.loc}</code><span>HTTP {item.status ?? "—"} · {item.indexable === true ? "indexable" : item.indexable === false ? "no indexable" : "sin cobertura"} · {item.lastmod || "sin lastmod"}</span></div>)}</div>}</details>)}</div> : <p class="empty-copy">No se guardó ningún sitemap en este snapshot.</p>}</section>
  <section class="inventory-card"><header><div><span class="pill">Directivas</span><h3>robots.txt</h3></div><strong>{inventory.robots?.status ?? "—"}</strong></header><p>{inventory.robots?.summary || (inventory.robots?.rules?.length ? `${inventory.robots.rules.length} directivas detectadas.` : "Sin datos de robots.txt.")}</p>{inventory.robots?.groups?.length > 0 && <ul>{inventory.robots.groups.map((group) => <li><code>{group.userAgent}</code> · {group.rules?.length || 0} reglas</li>)}</ul>}{inventory.robots?.rules?.length > 0 && <ul>{inventory.robots.rules.map((rule) => <li><code>{rule.directive}</code> · {rule.value}</li>)}</ul>}</section>
  <section class="inventory-card"><header><div><span class="pill">Datos estructurados</span><h3>Schema</h3></div><strong>{schemas.length}</strong></header><p>{inventory.schemas?.summary || "Tipos detectados en el HTML rastreado."}</p>{schemas.length > 0 && <div class="chip-list">{schemas.map((item) => <span>{item.type || item} {item.pages ? `· ${item.pages}` : ""}</span>)}</div>}</section>
  {resourceGroups.map(([label, resources]) => <section class="inventory-card"><header><div><span class="pill">Recurso</span><h3>{label}</h3></div><strong>{resources.length}</strong></header><div class="resource-list">{resources.map((resource) => <div><code>{resource.url || resource.name}</code><span class={`resource-status status-${resource.status === 200 || resource.exists ? "ok" : "missing"}`}>{resource.status ?? (resource.exists ? "Disponible" : "Ausente")}</span></div>)}</div>{resources.length === 0 && <p class="empty-copy">Sin elementos registrados.</p>}</section>)}
</div>
