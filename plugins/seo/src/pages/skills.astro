---
import Layout from "../layouts/Layout.astro";
import { skillCatalog } from "../skill-catalog.mjs";
const all = await skillCatalog();
const query = Astro.url.searchParams.get("query")?.toLowerCase() || "";
const category = Astro.url.searchParams.get("category") || "";
const categories = [...new Set(all.map((s)=>s.category))].sort();
const skills = all.filter((s)=>(!query || `${s.name} ${s.description}`.toLowerCase().includes(query)) && (!category || s.category===category));
---
<Layout title="Skills · SEO Workspace"><p class="eyebrow">53 capacidades</p><h1>Todo lo que sabe hacer el plugin.</h1><p class="lede">Las skills aportan procesos y conocimiento. No amplían por sí mismas los permisos de Codex.</p><form class="panel filters" method="get"><input type="search" name="query" value={query} placeholder="Buscar skill…" /><select name="category"><option value="">Todas las categorías</option>{categories.map((c)=><option value={c} selected={category===c}>{c}</option>)}</select><button type="submit">Filtrar</button></form><section class="grid">{skills.map((skill)=><article class="card"><div class="card-top"><span class="pill">{skill.category}</span><span class="muted">{skill.source}</span></div><h2>{skill.name}</h2><p>{skill.description}</p><div class="card-footer"><span class="muted">{skill.access}</span></div></article>)}</section></Layout>
