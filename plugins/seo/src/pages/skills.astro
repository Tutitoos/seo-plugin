---
import Layout from "../layouts/Layout.astro";
import { skillCatalog } from "../skill-catalog.mjs";
const all = await skillCatalog();
const query = Astro.url.searchParams.get("query")?.toLowerCase() || "";
const category = Astro.url.searchParams.get("category") || "";
const categories = [...new Set(all.map((s)=>s.category))].sort();
const skills = all.filter((s)=>(!query || `${s.name} ${s.description}`.toLowerCase().includes(query)) && (!category || s.category===category));
---
<Layout title="Skills · SEO Workspace"><header class="page-intro"><p class="eyebrow">53 capacidades · Catálogo completo</p><h1>Todo lo que sabe hacer el plugin.</h1><p class="lede">Las skills aportan procesos y conocimiento. No amplían por sí mismas los permisos de Codex.</p></header><form class="panel filters filters-compact" method="get"><label class="field"><span class="field-label">Buscar</span><input type="search" name="query" value={query} placeholder="Nombre o finalidad…" /></label><label class="field"><span class="field-label">Categoría</span><select name="category"><option value="">Todas las categorías</option>{categories.map((c)=><option value={c} selected={category===c}>{c}</option>)}</select></label><button type="submit">Filtrar</button></form><div class="section-head"><h2>Skills</h2><span class="muted">{skills.length} resultados</span></div><section class="grid">{skills.map((skill)=><article class="card"><div class="card-top"><span class="pill">{skill.category}</span><span class="muted">{skill.source}</span></div><div><h2>{skill.name}</h2><p>{skill.description}</p></div><div class="card-footer"><span class="muted">{skill.access}</span></div></article>)}</section></Layout>
