---
import Layout from "../../../../layouts/Layout.astro";
import AuditVisuals from "../../../../components/AuditVisuals.astro";
import FindingsPanel from "../../../../components/FindingsPanel.astro";
import { AuditStore } from "../../../../audit-store.mjs";
import { AuditDetailStore } from "../../../../audit-detail-store.mjs";
import { issueCsrfToken } from "../../../../csrf.mjs";
const { id, pageId } = Astro.params;
const store = new AuditDetailStore();
let detail;
try { detail = await store.getPage(id, pageId); } catch { return Astro.redirect(`/audits/${id}?view=pages`); }
const { manifest, page, metrics, findings } = detail;
const history: any[] = [];
for (const snapshot of (await new AuditStore().projectHistory(manifest.project.slug)).snapshots) {
  if (snapshot.id === manifest.id) continue;
  try { const previous = await store.getPage(snapshot.id, page.id); history.push({ id: snapshot.id, createdAt: snapshot.createdAt, status: snapshot.status, score: previous.page.health, kpis: previous.metrics.kpis || [] }); } catch {}
}
const csrfToken = issueCsrfToken(Astro.cookies);
const returnTo = `${Astro.url.pathname}${Astro.url.search}`;
const pairs = (object: Record<string, unknown> = {}) => Object.entries(object).filter(([,value]) => value !== undefined && value !== null && typeof value !== "object");
const renderValue = (value: unknown) => typeof value === "boolean" ? (value ? "Sí" : "No") : String(value);
const issueTotal = Object.values(page.issueCounts || {}).reduce((sum: number, value: unknown) => sum + (Number(value) || 0), 0);
---
<Layout title={`${page.metadata?.title || page.url} · SEO Workspace`}>
  <header class="page-intro page-detail-intro"><p class="eyebrow"><a href={`/audits/${id}/pages`}>← Todas las páginas</a></p><div class="page-title-row"><div><h1>{page.metadata?.title || new URL(page.url).pathname}</h1><a class="page-url" href={page.url} target="_blank" rel="noreferrer">{page.url}</a></div><span class={`health health-${page.health}`}>{page.health}</span></div></header>
  {Astro.url.searchParams.get("issueSaved") && <div class="flash flash-success" role="status">Seguimiento actualizado correctamente.</div>}{Astro.url.searchParams.get("issueError") && <div class="flash flash-error" role="alert">{Astro.url.searchParams.get("issueError")}</div>}
  <section class="page-facts"><article><span>HTTP</span><strong>{page.response?.status ?? "—"}</strong><small>{page.response?.contentType || "Sin content-type"}</small></article><article><span>Indexable</span><strong>{page.indexability?.indexable === true ? "Sí" : page.indexability?.indexable === false ? "No" : "—"}</strong><small>{page.indexability?.reason || "Sin observación"}</small></article><article><span>Cobertura</span><strong>{page.coverage}</strong><small>{page.auditLevel === "deep" ? "Auditoría profunda" : "Auditoría ligera"}</small></article><article><span>Incidencias</span><strong>{issueTotal}</strong><small>{page.issueCounts?.p0 || 0} P0 · {page.issueCounts?.p1 || 0} P1</small></article></section>
  {page.diagnostics?.length > 0 && <section class="page-diagnostics" aria-label="Cobertura incompleta">{page.diagnostics.map((item: any) => <article class="diagnostic diagnostic-retry"><header><code>{item.code}</code><span>Cobertura de página</span></header><h3>{item.message}</h3>{item.completenessImpact && <p><strong>Efecto:</strong> {item.completenessImpact}</p>}{item.nextAction && <p><strong>Siguiente acción:</strong> {item.nextAction}</p>}</article>)}</section>}
  {page.screenshots?.length > 0 && <section><div class="section-head"><div><p class="eyebrow">Evidencia visual</p><h2>Capturas</h2></div></div><div class="screenshot-grid">{page.screenshots.map((shot: any) => <figure><img src={`/api/audits/${id}/pages/${page.id}/assets/${shot.path.replace(/^assets\//,"")}`} alt={shot.label} loading="lazy" /><figcaption>{shot.label}</figcaption></figure>)}</div></section>}
  <section><div class="section-head"><div><p class="eyebrow">Diagnóstico de la URL</p><h2>Señales técnicas</h2></div></div><div class="signal-grid">{[["Respuesta",page.response],["Indexabilidad",page.indexability],["Metadatos",page.metadata],["Enlaces",page.links],["Imágenes",page.images],["Schema",page.schemas],["Rendimiento",page.performance],["Search Console",page.searchConsole],["Analytics",page.analytics]].map(([label,data]) => <article class="signal-card"><h3>{label}</h3>{pairs(data).length ? <dl>{pairs(data).map(([key,value]) => <><dt>{key}</dt><dd>{renderValue(value)}</dd></>)}</dl> : <p class="muted">Sin datos para esta fuente.</p>}</article>)}</div></section>
  <section><div class="section-head"><div><p class="eyebrow">Arquitectura de esta página</p><h2>Enlaces, hreflang y schema</h2></div></div><div class="link-evidence-grid"><article><h3>Páginas enlazantes</h3>{page.links?.incoming?.length ? <ul>{page.links.incoming.map((url: string) => <li><a href={url} target="_blank" rel="noreferrer">{url}</a></li>)}</ul> : <p class="muted">No se detectaron páginas enlazantes dentro de la cobertura.</p>}</article><article><h3>Enlaces internos salientes</h3>{page.links?.internal?.length ? <ul>{page.links.internal.map((url: string) => <li><a href={url} target="_blank" rel="noreferrer">{url}</a></li>)}</ul> : <p class="muted">No se detectaron enlaces internos.</p>}</article><article><h3>Alternates hreflang</h3>{page.metadata?.hreflang?.length ? <ul>{page.metadata.hreflang.map((item: any) => <li><code>{item.locale}</code> <a href={item.url} target="_blank" rel="noreferrer">{item.url}</a></li>)}</ul> : <p class="muted">No se declararon alternates hreflang.</p>}</article><article><h3>Tipos Schema</h3>{page.schemas?.types?.length ? <div class="chip-list">{page.schemas.types.map((type: string) => <span>{type}</span>)}</div> : <p class="muted">No se detectó JSON-LD válido.</p>}</article></div></section>
  {(metrics.kpis?.length > 0 || metrics.charts?.length > 0) && <AuditVisuals mode="page" auditId={id} projectId={manifest.project.slug} metrics={metrics} history={history} />}
  <section><div class="section-head"><div><p class="eyebrow">Evolución entre snapshots</p><h2>Histórico de esta URL</h2></div><span class="muted">{history.length} comparables</span></div>{history.length ? <div class="history-strip">{history.map((snapshot: any) => <a href={`/audits/${snapshot.id}/pages/${page.id}`}><span>{snapshot.createdAt.slice(0,10)}</span><strong>{snapshot.score}</strong><small>{snapshot.status}</small></a>)}</div> : <div class="panel tab-empty"><strong>Todavía no hay un snapshot anterior comparable.</strong><p>La próxima auditoría mostrará cambios de salud, incidencias y métricas de esta misma URL.</p></div>}</section>
  <section><div class="section-head"><div><p class="eyebrow">Problemas y correcciones</p><h2>Hallazgos de esta página</h2></div><span class="muted">{findings.length}</span></div><FindingsPanel findings={findings} projectId={manifest.project.slug} csrfToken={csrfToken} returnTo={returnTo} /></section>
</Layout>
