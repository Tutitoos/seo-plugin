---
import Layout from "../../layouts/Layout.astro";
import AuditVisuals from "../../components/AuditVisuals.astro";
import { AuditStore } from "../../audit-store.mjs";
import { AuditDetailStore } from "../../audit-detail-store.mjs";
import { issueCsrfToken } from "../../csrf.mjs";
import { marked } from "marked";
import sanitizeHtml from "sanitize-html";
const { id } = Astro.params;
let audit;
try { audit = await new AuditStore().get(id); } catch { return Astro.redirect("/"); }
const history = (await new AuditStore().projectHistory(audit.manifest.project.slug)).snapshots;
const detailStore = new AuditDetailStore();
const [{ findings }, { inventory, diagnostics }, pagesResult, tracker] = await Promise.all([detailStore.getFindings(audit.manifest.id), detailStore.getInventory(audit.manifest.id), detailStore.listPages(audit.manifest.id, { limit: 100 }), detailStore.listIssues(audit.manifest.project.slug)]);
const findingsWithWorkflow = findings.map((finding: any) => ({ ...finding, workflow: tracker.issues.find((issue: any) => issue.fingerprint === finding.fingerprint) || null }));
const csrfToken = issueCsrfToken(Astro.cookies);
const returnTo = `${Astro.url.pathname}${Astro.url.search}`;
const html = sanitizeHtml(await marked.parse(audit.reportMarkdown || "_Esta auditoría todavía no tiene contenido._"), { allowedTags: sanitizeHtml.defaults.allowedTags.concat(["img"]), allowedAttributes: { a:["href","title"], img:["src","alt","title"] }, allowedSchemes:["http","https"] });
---
<Layout title={`${audit.manifest.title} · SEO Workspace`}><div class="detail"><header class="page-intro"><p class="eyebrow">{audit.manifest.project.name} · {audit.manifest.createdAt.slice(0,10)}</p><h1>{audit.manifest.title}</h1><p class="lede">{audit.manifest.summary}</p></header>{Astro.url.searchParams.get("issueSaved") && <div class="flash flash-success" role="status">Seguimiento actualizado correctamente.</div>}{Astro.url.searchParams.get("issueError") && <div class="flash flash-error" role="alert">{Astro.url.searchParams.get("issueError")}</div>}<section class="stats"><div class="stat"><strong>{audit.manifest.score ?? "—"}</strong><span>puntuación</span></div><div class="stat state"><strong>{audit.manifest.status}</strong><span>estado</span></div><div class="stat"><strong>{audit.manifest.skillsUsed.length}</strong><span>skills utilizadas</span></div></section><AuditVisuals auditId={audit.manifest.id} projectId={audit.manifest.project.slug} metrics={audit.metrics} coverage={audit.manifest.sourceCoverage || []} history={history} executive={audit.manifest.executive || {}} findings={findingsWithWorkflow} pagesResult={pagesResult} inventory={inventory} diagnostics={diagnostics} csrfToken={csrfToken} returnTo={returnTo} /><div class="section-head report-head"><div><p class="eyebrow">Diagnóstico completo</p><h2>Informe</h2></div></div><article class="prose" set:html={html} /></div></Layout>
